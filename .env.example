# Copy this file to .env and fill in your values.
# Never commit your real .env file.

# --- channels / AI (LARIS) ---
ILMU_API_KEY=
# ILMU_BASE_URL=https://api.ilmu.ai/v1
# ILMU_ASR_PATH=/audio/transcriptions   # unverified path
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
# Required: the Telegram route returns 403 until this is set (use it as setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Shared bearer token for /api (set it on any public URL; the UI asks for it once per tab)
APP_TOKEN=
# Approved WhatsApp utility template used when the 24h window has closed (body takes one {{1}} parameter)
# WHATSAPP_FOLLOWUP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en
# Browser origins allowed to call the API (comma separated); default is localhost
# CORS_ORIGINS=http://localhost:5173
# Org logo shown beside the LARIS logo (tenants has no logo column yet)
# ORG_LOGO_URL=
# Minutes between scheduler runs (follow-ups, expiry)
# SCHEDULER_MINUTES=15
# Days to keep chat message text before it is blanked (0 = keep forever)
# RETENTION_DAYS=180
# RunPod fallback (optional)
RUNPOD_ENDPOINT_URL=
RUNPOD_API_KEY=

# --- deploy (Replit) ---
# Replit sets DATABASE_URL itself when PostgreSQL is added. Locally, point it at your own Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/laris
# SCHEDULER=1 is set in .replit. Use 0 locally to keep APScheduler off.
SCHEDULER=0
# SEED=1 only for the one demo bootstrap (synthetic data). Remove afterwards.
SEED=0
