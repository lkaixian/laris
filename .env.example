# Copy this file to .env and fill in your values.
# Never commit your real .env file.

# --- channels / AI (LARIS) ---
ILMU_API_KEY=
# ILMU_BASE_URL=https://api.ilmu.ai/v1
# ILMU_ASR_PATH=/audio/transcriptions   # unverified path
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
# Required: the Telegram route returns 403 until this is set (use it as setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Shared bearer token for /api, demo mode only (needs DEMO_MODE=1; users of the first tenant only; the UI asks for it once per tab)
APP_TOKEN=
# 1 = headers alone no longer identify anyone; every /api call needs a per-user token (scripts/create_token.py)
# REQUIRE_USER_TOKEN=0
# 1 = allow header-only demo mode (X-Role / X-User, no sign-in) on a Replit deployment or with APP_TOKEN set; off for good once any account has a password
# DEMO_MODE=0
# Hours a sign-in lasts
# SESSION_HOURS=12
# 1 = behind a trusted proxy (Replit): client address for sign-in throttling = LAST X-Forwarded-For entry. Leave unset otherwise (spoofable)
# TRUST_PROXY=0
# Approved WhatsApp utility template used when the 24h window has closed (body takes one {{1}} parameter)
# WHATSAPP_FOLLOWUP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en
# Approved template for Ask suppliers outside the 24h window: IMAGE header (the photo) and one body {{1}} (the note). Unset = such sends fail with a clear error
# WHATSAPP_RFQ_TEMPLATE=
# Browser origins allowed to call the API (comma separated); default is localhost
# CORS_ORIGINS=http://localhost:5173
# 1 = serve /docs, /redoc and /openapi.json (developer machines only; off by default)
# ENABLE_DOCS=0
# Org logo shown beside the LARIS logo (tenants has no logo column yet)
# ORG_LOGO_URL=
# Minutes between scheduler runs (follow-ups, expiry)
# SCHEDULER_MINUTES=15
# Days to keep chat message text before it is blanked (0 = keep forever)
# RETENTION_DAYS=180
# RunPod fallback (optional)
RUNPOD_ENDPOINT_URL=
RUNPOD_API_KEY=
# Catalog photos (vision model on RunPod, section 10b of docs/deploy.md); URL ends with /openai/v1
RUNPOD_VISION_URL=
# RUNPOD_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# --- deploy (Replit) ---
# Replit sets DATABASE_URL itself when PostgreSQL is added. Locally, point it at your own Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/laris
# Optional: schema owner URL for startup migrations when DATABASE_URL is the least-privilege laris_app role (db/roles.sql)
# DATABASE_URL_OWNER=
# Set to 1 to refuse to start when the database user is a superuser/BYPASSRLS role (tenant isolation would be off). See docs/deploy.md.
# REQUIRE_RLS=1
# SCHEDULER=1 is set in .replit. Use 0 locally to keep APScheduler off.
SCHEDULER=0
# SEED=1 only for the one demo bootstrap (synthetic data). Remove afterwards.
SEED=0
