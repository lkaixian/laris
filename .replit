# Replit config. Dev Run and Reserved VM deployment both use run.sh (single uvicorn worker).
# Unverified on Replit: deploymentTarget value, [nix] channel, port mapping. Check in the Deployments pane.
run = "bash run.sh"
modules = ["python-base-3.13", "nodejs-24"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "libyaml", "openjpeg", "postgresql", "tcl", "tesseract", "tk", "zlib"]

[deployment]
deploymentTarget = "vm"
build = ["bash", "-c", 'PIP_USER=0 python -m pip install --prefix="$PWD/.pythonlibs" -q -r requirements.txt && cd web && npm ci && npm run build']
run = ["bash", "run.sh"]

[[ports]]
localPort = 5000
externalPort = 80

# Non-secret flags only. Secrets go in Replit Secrets, never here.
# SEED=1 is NOT set here: set it in Secrets for the one demo bootstrap, then remove it.
[env]
SCHEDULER = "1"

PIP_USER = "0"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash run.sh"
waitForPort = 5000

[userenv]

[userenv.shared]
PIP_PREFIX = ".pythonlibs"
PIP_USER = "0"
